---
import Layout from '../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const success = url.searchParams.get('success') === 'true';
const position = url.searchParams.get('position');
const code = url.searchParams.get('code');
const error = url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  missing_token: 'Verification link is incomplete. Please use the link from your email.',
  invalid_token: 'Verification link is invalid or expired. Please try signing up again.',
  server: 'Something went wrong. Please try again later.',
  config: 'Service temporarily unavailable. Please try again later.',
};

const errorMessage = error ? errorMessages[error] || 'An error occurred.' : '';
---

<Layout title={success ? 'Email Verified - Illoominate' : 'Verification Error - Illoominate'}>
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="max-w-md w-full text-center">
      {success ? (
        <div>
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-green-500/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <h1 class="text-3xl font-bold text-white mb-4">
            Email Verified!
          </h1>

          <p class="text-zinc-400 mb-6">
            You're <span class="text-indigo-400 font-semibold">#{position}</span> on the waitlist.
            Check your inbox for your welcome email with your referral code.
          </p>

          {code && (
            <div class="bg-zinc-900/50 border border-zinc-800 rounded-lg p-4 mb-6">
              <p class="text-sm text-zinc-500 mb-2">Your referral code:</p>
              <p class="text-2xl font-mono font-bold text-indigo-400 tracking-widest">{code}</p>
              <p class="text-xs text-zinc-600 mt-2">Share with friends to move up the list</p>
            </div>
          )}

          <a
            href="/"
            class="inline-block px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-lg transition-colors"
          >
            Back to Home
          </a>
        </div>
      ) : (
        <div>
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-red-500/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>

          <h1 class="text-3xl font-bold text-white mb-4">
            Verification Failed
          </h1>

          <p class="text-zinc-400 mb-6">
            {errorMessage}
          </p>

          <a
            href="/#waitlist"
            class="inline-block px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-lg transition-colors"
          >
            Try Again
          </a>
        </div>
      )}
    </div>
  </main>
</Layout>
