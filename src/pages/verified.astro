---
import Layout from '../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const success = url.searchParams.get('success') === 'true';
const position = url.searchParams.get('position');
const code = url.searchParams.get('code');
const error = url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  missing_token: 'Verification link is incomplete. Please use the link from your email.',
  invalid_token: 'Verification link is invalid or expired. Please try signing up again.',
  server: 'Something went wrong. Please try again later.',
  config: 'Service temporarily unavailable. Please try again later.',
};

const errorMessage = error ? errorMessages[error] || 'An error occurred.' : '';
---

<Layout title={success ? 'Email Verified - Illoominate' : 'Verification Error - Illoominate'}>
  <main class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background: Subtle gradient with noise texture (matching Hero) -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#0a0a0a] via-[#0f0f1a] to-[#0a0a0a]"></div>
    
    <!-- Mesh gradient accents -->
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-1/3 right-1/4 w-80 h-80 bg-violet-600/15 rounded-full blur-[100px]"></div>
    </div>
    
    <!-- Noise texture overlay -->
    <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-lg w-full mx-auto px-6 text-center">
      {success ? (
        <div>
          <!-- Success badge -->
          <div class="verified-badge mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 backdrop-blur-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-sm text-emerald-400">Email verified</span>
          </div>

          <!-- Headline -->
          <h1 class="verified-headline text-4xl md:text-5xl font-bold tracking-tight mb-6 bg-gradient-to-b from-white via-white to-zinc-500 bg-clip-text text-transparent">
            You're in!
          </h1>

          <!-- Position -->
          <p class="verified-tagline text-xl text-zinc-400 mb-8 leading-relaxed">
            You're <span class="text-indigo-400 font-semibold">#{position}</span> on the waitlist.<br />
            <span class="text-zinc-500">Check your inbox for your welcome email.</span>
          </p>

          {code && (
            <div class="verified-card mb-8 p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm">
              <p class="text-sm text-zinc-500 mb-3">Your referral code</p>
              <p class="text-3xl font-mono font-bold text-indigo-400 tracking-widest mb-3">{code}</p>
              <p class="text-sm text-zinc-600">Share with friends to move up the list</p>
            </div>
          )}

          <a
            href="/"
            class="verified-cta inline-flex items-center gap-2 px-8 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition-all duration-200 hover:translate-y-[-2px] hover:shadow-[0_0_40px_rgba(99,102,241,0.4)]"
          >
            Back to Home
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      ) : (
        <div>
          <!-- Error badge -->
          <div class="verified-badge mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-red-500/20 bg-red-500/10 backdrop-blur-sm">
            <span class="w-2 h-2 rounded-full bg-red-400"></span>
            <span class="text-sm text-red-400">Verification failed</span>
          </div>

          <!-- Headline -->
          <h1 class="verified-headline text-4xl md:text-5xl font-bold tracking-tight mb-6 bg-gradient-to-b from-white via-white to-zinc-500 bg-clip-text text-transparent">
            Something went wrong
          </h1>

          <!-- Error message -->
          <p class="verified-tagline text-xl text-zinc-400 mb-8 leading-relaxed">
            {errorMessage}
          </p>

          <a
            href="/#waitlist"
            class="verified-cta inline-flex items-center gap-2 px-8 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition-all duration-200 hover:translate-y-[-2px] hover:shadow-[0_0_40px_rgba(99,102,241,0.4)]"
          >
            Try Again
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  /* Staggered fade-in animations (matching Hero) */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .verified-badge {
    animation: fadeInUp 0.6s ease-out;
  }

  .verified-headline {
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }

  .verified-tagline {
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  .verified-card {
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }

  .verified-cta {
    animation: fadeInUp 0.6s ease-out 0.4s both;
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .verified-badge,
    .verified-headline,
    .verified-tagline,
    .verified-card,
    .verified-cta {
      animation: none;
      opacity: 1;
    }
  }
</style>
