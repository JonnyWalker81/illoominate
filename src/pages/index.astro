---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<Layout title="Illoominate - Native User Feedback">
  <main>
    <Hero />
    <Features />
    <WaitlistForm />
    
    <!-- Footer -->
    <footer class="py-8 text-center border-t border-zinc-900">
      <p class="text-sm text-zinc-600">
        &copy; {new Date().getFullYear()} Illoominate. Building in public.
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* Smooth scrolling for anchor links */
  html {
    scroll-behavior: smooth;
  }
</style>
