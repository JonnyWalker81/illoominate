---
/**
 * TrustBlock component - Social proof section
 * Displays framework support, milestone progress bar (when > 10 users), and trust signals
 */
const waitlistCount = 1; // TODO: Fetch from API at build time
const goal = 500;
const percentage = Math.min(Math.round((waitlistCount / goal) * 100), 100);
const remaining = goal - waitlistCount;
const showMilestone = waitlistCount > 10;
---

<section class="py-12 border-y border-zinc-900 bg-[#0a0a0a]">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Framework support -->
    <div class="flex flex-wrap items-center justify-center gap-8 mb-8">
      <span class="text-xs text-zinc-600 uppercase tracking-wider">Coming to</span>

      <!-- iOS -->
      <div class="flex items-center gap-2 text-zinc-500">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <span class="text-sm font-medium">iOS</span>
      </div>

      <!-- Web -->
      <div class="flex items-center gap-2 text-zinc-500">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
        </svg>
        <span class="text-sm font-medium">Web</span>
      </div>

      <!-- Android (coming soon) -->
      <div class="flex items-center gap-2 text-zinc-500 opacity-50">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48C13.85 1.23 12.95 1 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31C6.97 3.26 6 5.01 6 7h12c0-1.99-.97-3.75-2.47-4.84zM10 5H9V4h1v1zm5 0h-1V4h1v1z"/>
        </svg>
        <span class="text-sm font-medium">Android</span>
        <span class="text-xs text-zinc-600">(soon)</span>
      </div>
    </div>

    {showMilestone ? (
      <!-- Milestone Progress (shown when > 10 users) -->
      <div class="max-w-sm mx-auto mb-8 rounded-xl bg-[#111] border border-white/10 p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-zinc-400">Founding members</span>
          <span class="text-sm">
            <span class="text-indigo-400 font-semibold">{waitlistCount}</span>
            <span class="text-zinc-500"> / {goal}</span>
          </span>
        </div>

        <!-- Progress bar with animation -->
        <div class="h-2 bg-zinc-800 rounded-full overflow-hidden">
          <div
            class="progress-fill h-full bg-gradient-to-r from-indigo-600 to-indigo-400 rounded-full"
            style={`--target-width: ${percentage}%`}
          ></div>
        </div>

        <!-- Urgency message -->
        <p class="text-xs text-zinc-500 mt-2">
          <span class="text-emerald-400 font-medium">{remaining} spots left</span>
          {' '}at founding member pricing
        </p>
      </div>

      <!-- Early access callout with count -->
      <p class="text-center text-sm text-zinc-500 mb-8">
        Join {waitlistCount}+ developers building the future of feedback
      </p>
    ) : (
      <!-- General callout (shown when <= 10 users) -->
      <div class="max-w-sm mx-auto mb-8 rounded-xl bg-[#111] border border-white/10 p-4 text-center">
        <p class="text-sm text-zinc-400 mb-1">Be a founding member</p>
        <p class="text-xs text-zinc-500">
          Early supporters get <span class="text-emerald-400 font-medium">lifetime discounts</span> and priority access
        </p>
      </div>

      <!-- Early access callout without count -->
      <p class="text-center text-sm text-zinc-500 mb-8">
        Join developers building the future of feedback
      </p>
    )}

    <!-- Trust signals -->
    <div class="flex flex-wrap items-center justify-center gap-6">
      <!-- GDPR Compliant -->
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
        </svg>
        <span class="text-xs text-zinc-600">GDPR Compliant</span>
      </div>

      <!-- Zero main thread impact -->
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 2v11h3v9l7-12h-4l4-8z"/>
        </svg>
        <span class="text-xs text-zinc-600">Zero main thread impact</span>
      </div>
    </div>
  </div>
</section>

<style>
  .progress-fill {
    width: 0;
    animation: fillProgress 1s ease-out 0.5s forwards;
  }

  @keyframes fillProgress {
    to { width: var(--target-width); }
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-fill {
      animation: none;
      width: var(--target-width);
    }
  }
</style>
