---
/**
 * Features section with icon cards grid
 * Linear/Vercel inspired minimal design with subtle hover effects
 */

const features = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
    </svg>`,
    title: 'Native SDKs',
    description: 'iOS and Web SDKs that feel like part of your app. No webviews, no compromises on user experience.'
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
    </svg>`,
    title: 'Organized Dashboard',
    description: 'Boards, statuses, and filtering to keep feedback organized. Know exactly what your users want.'
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
    </svg>`,
    title: 'Public Roadmap',
    description: 'Share what you\'re building. Let users vote on priorities and see when features ship.'
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>`,
    title: 'Startup-Friendly Pricing',
    description: 'No per-user fees that punish growth. Simple tiers that scale with your success, not against it.'
  }
];
---

<section class="relative py-24 overflow-hidden">
  <!-- Background: Mesh gradient -->
  <div class="absolute inset-0 bg-[#0a0a0a]">
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-violet-600/8 rounded-full blur-[120px]"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Everything you need
      </h2>
      <p class="text-lg text-zinc-400 max-w-2xl mx-auto">
        A complete feedback platform built for developers who care about user experience.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature, index) => (
        <article 
          class="feature-card group p-6 rounded-2xl bg-[#111]/80 border border-white/5 backdrop-blur-sm transition-all duration-300 hover:border-indigo-500/30 hover:bg-[#151515]"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <!-- Icon -->
          <div class="mb-4 text-indigo-400 transition-colors duration-300 group-hover:text-indigo-300" set:html={feature.icon} />
          
          <!-- Title -->
          <h3 class="text-lg font-semibold text-white mb-2 transition-colors duration-300 group-hover:text-indigo-100">
            {feature.title}
          </h3>
          
          <!-- Description -->
          <p class="text-sm text-zinc-500 leading-relaxed transition-colors duration-300 group-hover:text-zinc-400">
            {feature.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .feature-card {
    animation: fadeInUp 0.6s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      animation: none;
      opacity: 1;
    }
  }
</style>
