---
/**
 * Post-signup quiz modal - 5-step wizard
 * One question per screen with progress bar and visual card choices
 * Implements PMF (Product-Market Fit) measurement via disappointment question
 */
---

<div id="quiz-modal" class="hidden fixed inset-0 z-50">
  <!-- Backdrop -->
  <div 
    class="absolute inset-0 bg-black/80 backdrop-blur-sm" 
    data-close-modal
  ></div>

  <!-- Modal content -->
  <div class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg p-4 sm:p-6">
    <div class="bg-[#111] border border-zinc-800 rounded-2xl relative overflow-hidden">
      <!-- Close button -->
      <button 
        class="absolute top-4 right-4 z-10 text-zinc-500 hover:text-white transition-colors"
        data-close-modal
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Progress bar with incentive -->
      <div class="px-8 pt-6">
        <div class="flex items-center justify-between mb-2">
          <span id="progress-text" class="text-sm text-zinc-400">Step 1 of 5</span>
          <span id="incentive-text" class="text-sm text-emerald-400 font-medium">4 questions left for +5</span>
        </div>
        <div class="h-1.5 bg-zinc-800 rounded-full overflow-hidden">
          <div
            id="progress-bar"
            class="h-full bg-gradient-to-r from-indigo-600 to-indigo-400 rounded-full transition-all duration-500 ease-out"
            style="width: 20%"
          ></div>
        </div>
      </div>

      <!-- Form container -->
      <form id="quiz-form" class="p-8 pt-6">
        <input type="hidden" id="quiz-waitlist-id" name="waitlistId" />

        <!-- Step 1: Role -->
        <div id="step-1" class="quiz-step" data-step="1">
          <!-- Chat bubble question -->
          <div class="flex items-start gap-3 mb-6">
            <!-- Bot avatar -->
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
              </svg>
            </div>

            <!-- Question bubble -->
            <div class="bg-[#1a1a1a] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
              <h2 class="text-lg font-medium text-white mb-1">What's your primary role?</h2>
              <p class="text-zinc-500 text-sm">Help us tailor Illoominate to your workflow</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="quiz-card group" data-field="role" data-value="developer">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Developer</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="role" data-value="founder">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Founder</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="role" data-value="pm">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Product Manager</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="role" data-value="designer">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Designer</span>
            </button>
            
            <button type="button" class="quiz-card group col-span-2" data-field="role" data-value="other">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Other</span>
            </button>
          </div>
        </div>

        <!-- Step 2: Platform -->
        <div id="step-2" class="quiz-step hidden" data-step="2">
          <!-- Chat bubble question -->
          <div class="flex items-start gap-3 mb-6">
            <!-- Bot avatar -->
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
              </svg>
            </div>

            <!-- Question bubble -->
            <div class="bg-[#1a1a1a] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
              <h2 class="text-lg font-medium text-white mb-1">What platforms do you build for?</h2>
              <p class="text-zinc-500 text-sm">Select your primary development focus</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="quiz-card group" data-field="platform" data-value="ios">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                </svg>
              </div>
              <span class="text-white font-medium">iOS</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="platform" data-value="android">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85-.29-.15-.65-.06-.83.22l-1.88 3.24c-1.49-.68-3.14-1.07-4.93-1.07-1.79 0-3.44.39-4.93 1.07L4.69 5.67c-.19-.29-.58-.38-.87-.2-.28.18-.37.54-.22.83L5.44 9.5C2.83 10.9 1 13.5 1 16.5h22c0-3-1.83-5.6-4.4-7.02zM7 14.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm10 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
                </svg>
              </div>
              <span class="text-white font-medium">Android</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="platform" data-value="web">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Web</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="platform" data-value="multiple">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Multiple</span>
            </button>
          </div>
          
          <!-- Back button -->
          <button type="button" class="back-btn mt-6 text-zinc-500 hover:text-zinc-300 text-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back
          </button>
        </div>

        <!-- Step 3: Team Size -->
        <div id="step-3" class="quiz-step hidden" data-step="3">
          <!-- Chat bubble question -->
          <div class="flex items-start gap-3 mb-6">
            <!-- Bot avatar -->
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
              </svg>
            </div>

            <!-- Question bubble -->
            <div class="bg-[#1a1a1a] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
              <h2 class="text-lg font-medium text-white mb-1">How big is your team?</h2>
              <p class="text-zinc-500 text-sm">We'll optimize for your team's needs</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="quiz-card group" data-field="teamSize" data-value="solo">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <span class="text-white font-medium">Solo</span>
              <span class="text-zinc-500 text-xs mt-1">Just me</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="teamSize" data-value="small">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </div>
              <span class="text-white font-medium">2-5</span>
              <span class="text-zinc-500 text-xs mt-1">Small team</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="teamSize" data-value="medium">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <span class="text-white font-medium">6-20</span>
              <span class="text-zinc-500 text-xs mt-1">Growing team</span>
            </button>
            
            <button type="button" class="quiz-card group" data-field="teamSize" data-value="large">
              <div class="icon-container w-12 h-12 rounded-xl bg-zinc-800 group-hover:bg-indigo-500/20 flex items-center justify-center mb-3 transition-colors">
                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </div>
              <span class="text-white font-medium">20+</span>
              <span class="text-zinc-500 text-xs mt-1">Enterprise</span>
            </button>
          </div>
          
          <!-- Back button -->
          <button type="button" class="back-btn mt-6 text-zinc-500 hover:text-zinc-300 text-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back
          </button>
        </div>

        <!-- Step 4: PMF Question (Superhuman method) -->
        <div id="step-4" class="quiz-step hidden" data-step="4">
          <!-- Chat bubble question -->
          <div class="flex items-start gap-3 mb-6">
            <!-- Bot avatar -->
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
              </svg>
            </div>

            <!-- Question bubble -->
            <div class="bg-[#1a1a1a] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
              <h2 class="text-lg font-medium text-white mb-1">How disappointed would you be...</h2>
              <p class="text-zinc-500 text-sm">...if you couldn't use native-feeling feedback tools?</p>
            </div>
          </div>

          <div class="space-y-3">
            <button type="button" class="quiz-card-wide group" data-field="disappointmentLevel" data-value="very">
              <div class="w-10 h-10 rounded-lg bg-emerald-500/20 flex items-center justify-center transition-colors">
                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="flex-1 text-left">
                <span class="text-white font-medium">Very disappointed</span>
                <span class="text-zinc-500 text-sm block">I really need this</span>
              </div>
            </button>
            
            <button type="button" class="quiz-card-wide group" data-field="disappointmentLevel" data-value="somewhat">
              <div class="w-10 h-10 rounded-lg bg-amber-500/20 flex items-center justify-center transition-colors">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="flex-1 text-left">
                <span class="text-white font-medium">Somewhat disappointed</span>
                <span class="text-zinc-500 text-sm block">It would be nice to have</span>
              </div>
            </button>
            
            <button type="button" class="quiz-card-wide group" data-field="disappointmentLevel" data-value="not">
              <div class="w-10 h-10 rounded-lg bg-zinc-500/20 flex items-center justify-center transition-colors">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="flex-1 text-left">
                <span class="text-white font-medium">Not disappointed</span>
                <span class="text-zinc-500 text-sm block">I could live without it</span>
              </div>
            </button>
          </div>
          
          <!-- Back button -->
          <button type="button" class="back-btn mt-6 text-zinc-500 hover:text-zinc-300 text-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back
          </button>
        </div>

        <!-- Step 5: Pain Points (optional) -->
        <div id="step-5" class="quiz-step hidden" data-step="5">
          <!-- Chat bubble question -->
          <div class="flex items-start gap-3 mb-6">
            <!-- Bot avatar -->
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
              </svg>
            </div>

            <!-- Question bubble -->
            <div class="bg-[#1a1a1a] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
              <h2 class="text-lg font-medium text-white mb-1">What's your biggest feedback challenge?</h2>
              <p class="text-zinc-500 text-sm">Help us solve your specific problems (optional)</p>
            </div>
          </div>

          <textarea 
            id="painPoints"
            name="painPoints" 
            rows="4" 
            placeholder="e.g., Hard to collect feedback from mobile users, feedback gets lost in email, no way to prioritize requests..."
            class="w-full bg-[#0a0a0a] border border-zinc-700 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors outline-none resize-none text-sm"
          ></textarea>
          
          <div class="flex items-center justify-between mt-6">
            <button type="button" class="back-btn text-zinc-500 hover:text-zinc-300 text-sm transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Back
            </button>
            
            <div class="flex items-center gap-3">
              <button 
                type="button" 
                id="skip-btn"
                class="text-zinc-500 hover:text-zinc-300 text-sm transition-colors"
              >
                Skip
              </button>
              <button 
                type="submit"
                id="submit-btn"
                class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl transition-all hover:translate-y-[-1px]"
              >
                Complete
              </button>
            </div>
          </div>
        </div>

        <!-- Result Screen -->
        <div id="result-screen" class="hidden text-center py-4">
          <!-- Success animation -->
          <div class="relative mb-6">
            <div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center animate-pulse-slow">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <!-- Confetti particles -->
            <div id="confetti" class="absolute inset-0 pointer-events-none"></div>
          </div>
          
          <!-- Result type badge -->
          <div class="inline-block px-4 py-1.5 rounded-full bg-indigo-500/20 border border-indigo-500/30 mb-4">
            <span id="result-type" class="text-indigo-400 font-medium text-sm">iOS Pioneer</span>
          </div>
          
          <h3 class="text-2xl font-bold text-white mb-2">Thanks for your feedback!</h3>
          
          <!-- Position boost notification -->
          <div class="bg-emerald-500/10 border border-emerald-500/30 rounded-xl p-4 mt-6 mb-4">
            <div class="flex items-center justify-center gap-2 text-emerald-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
              </svg>
              <span class="font-semibold">You moved up 5 spots!</span>
            </div>
            <p class="text-emerald-400/70 text-sm mt-1">Thanks for completing the quiz</p>
          </div>
          
          <p class="text-zinc-400 text-sm">Your insights help us build a better product for you.</p>
          
          <button 
            type="button" 
            id="close-result-btn"
            class="mt-6 px-6 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-white font-medium rounded-xl transition-colors"
          >
            Done
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slide-in-right {
    from { 
      opacity: 0; 
      transform: translateX(20px); 
    }
    to { 
      opacity: 1; 
      transform: translateX(0); 
    }
  }
  
  @keyframes slide-out-left {
    from { 
      opacity: 1; 
      transform: translateX(0); 
    }
    to { 
      opacity: 0; 
      transform: translateX(-20px); 
    }
  }
  
  @keyframes pulse-slow {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  
  @keyframes confetti-fall {
    0% { 
      opacity: 1;
      transform: translateY(0) rotate(0deg); 
    }
    100% { 
      opacity: 0;
      transform: translateY(100px) rotate(720deg); 
    }
  }
  
  .animate-pulse-slow {
    animation: pulse-slow 2s ease-in-out infinite;
  }
  
  .quiz-step {
    animation: slide-in-right 0.3s ease-out;
  }
  
  .quiz-step.exiting {
    animation: slide-out-left 0.3s ease-out forwards;
  }
  
  .quiz-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(39 39 42);
    background-color: rgb(24 24 27 / 0.5);
    transition: all 0.2s;
    cursor: pointer;
  }
  
  .quiz-card:hover {
    border-color: rgb(99 102 241 / 0.5);
    background-color: rgb(99 102 241 / 0.05);
  }
  
  .quiz-card.selected {
    border-color: rgb(99 102 241);
    background-color: rgb(99 102 241 / 0.1);
  }
  
  .quiz-card.selected .icon-container {
    background-color: rgb(99 102 241 / 0.2);
  }
  
  .quiz-card.selected svg {
    color: rgb(129 140 248);
  }
  
  .quiz-card-wide {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(39 39 42);
    background-color: rgb(24 24 27 / 0.5);
    transition: all 0.2s;
    cursor: pointer;
    width: 100%;
  }
  
  .quiz-card-wide:hover {
    border-color: rgb(99 102 241 / 0.5);
    background-color: rgb(99 102 241 / 0.05);
  }
  
  .quiz-card-wide.selected {
    border-color: rgb(99 102 241);
    background-color: rgb(99 102 241 / 0.1);
  }
  
  .confetti-particle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    animation: confetti-fall 1s ease-out forwards;
  }
</style>

<script>
  const modal = document.getElementById('quiz-modal') as HTMLDivElement;
  const form = document.getElementById('quiz-form') as HTMLFormElement;
  const waitlistIdInput = document.getElementById('quiz-waitlist-id') as HTMLInputElement;
  const progressText = document.getElementById('progress-text') as HTMLSpanElement;
  const incentiveText = document.getElementById('incentive-text') as HTMLSpanElement;
  const progressBar = document.getElementById('progress-bar') as HTMLDivElement;
  const resultScreen = document.getElementById('result-screen') as HTMLDivElement;
  const resultType = document.getElementById('result-type') as HTMLSpanElement;
  const confettiContainer = document.getElementById('confetti') as HTMLDivElement;
  
  // Quiz state
  let currentStep = 1;
  const totalSteps = 5;
  const answers: Record<string, string> = {};

  // Open modal when event dispatched from WaitlistForm
  window.addEventListener('open-quiz', ((e: CustomEvent<{ waitlistId: number }>) => {
    waitlistIdInput.value = e.detail.waitlistId.toString();
    currentStep = 1;
    Object.keys(answers).forEach(key => delete answers[key]);
    showStep(1);
    updateProgress(1);
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Reset any selected states
    document.querySelectorAll('.quiz-card, .quiz-card-wide').forEach(card => {
      card.classList.remove('selected');
    });
    
    // Reset result screen
    resultScreen.classList.add('hidden');
    document.querySelectorAll('.quiz-step').forEach(step => {
      if (step.getAttribute('data-step') === '1') {
        step.classList.remove('hidden');
      } else {
        step.classList.add('hidden');
      }
    });
  }) as EventListener);

  // Close modal
  const closeModal = () => {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  };

  modal.querySelectorAll('[data-close-modal]').forEach(el => {
    el.addEventListener('click', closeModal);
  });

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Update progress bar and incentive message
  function updateProgress(step: number) {
    const percent = Math.round((step / totalSteps) * 100);
    progressText.textContent = `Step ${step} of ${totalSteps}`;
    progressBar.style.width = `${percent}%`;

    // Update incentive message
    if (incentiveText) {
      const remaining = totalSteps - step;
      if (remaining === 0) {
        incentiveText.textContent = 'Almost there!';
      } else if (remaining === 1) {
        incentiveText.textContent = '1 question left for +5';
      } else {
        incentiveText.textContent = `${remaining} questions left for +5`;
      }
    }
  }

  // Show specific step
  function showStep(step: number) {
    const currentStepEl = document.querySelector(`[data-step="${currentStep}"]`) as HTMLElement;
    const nextStepEl = document.querySelector(`[data-step="${step}"]`) as HTMLElement;
    
    if (currentStepEl && nextStepEl && currentStep !== step) {
      currentStepEl.classList.add('exiting');
      
      setTimeout(() => {
        currentStepEl.classList.add('hidden');
        currentStepEl.classList.remove('exiting');
        nextStepEl.classList.remove('hidden');
        currentStep = step;
      }, 250);
    }
    
    updateProgress(step);
  }

  // Handle card selection
  document.querySelectorAll('.quiz-card, .quiz-card-wide').forEach(card => {
    card.addEventListener('click', () => {
      const field = card.getAttribute('data-field');
      const value = card.getAttribute('data-value');
      
      if (field && value) {
        // Save answer
        answers[field] = value;
        
        // Update selected state
        const parent = card.closest('.quiz-step');
        parent?.querySelectorAll('.quiz-card, .quiz-card-wide').forEach(c => {
          c.classList.remove('selected');
        });
        card.classList.add('selected');
        
        // Auto-advance after short delay
        setTimeout(() => {
          if (currentStep < totalSteps) {
            showStep(currentStep + 1);
          }
        }, 300);
      }
    });
  });

  // Handle back buttons
  document.querySelectorAll('.back-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep > 1) {
        showStep(currentStep - 1);
      }
    });
  });

  // Handle skip button (step 5 only)
  document.getElementById('skip-btn')?.addEventListener('click', () => {
    submitQuiz();
  });

  // Handle close result button
  document.getElementById('close-result-btn')?.addEventListener('click', closeModal);

  // Generate confetti
  function createConfetti() {
    const colors = ['#6366f1', '#a855f7', '#ec4899', '#10b981', '#f59e0b'];
    
    for (let i = 0; i < 30; i++) {
      const particle = document.createElement('div');
      particle.className = 'confetti-particle';
      particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
      particle.style.left = `${Math.random() * 100}%`;
      particle.style.top = `${Math.random() * 50}%`;
      particle.style.animationDelay = `${Math.random() * 0.5}s`;
      confettiContainer.appendChild(particle);
    }
    
    // Clean up after animation
    setTimeout(() => {
      confettiContainer.innerHTML = '';
    }, 1500);
  }

  // Generate personalized type
  function generateType(answers: Record<string, string>): string {
    const role = answers.role || 'developer';
    const platform = answers.platform || 'web';
    const teamSize = answers.teamSize || 'small';
    
    let prefix = '';
    if (teamSize === 'solo') {
      prefix = 'Solo ';
    } else if (teamSize === 'large') {
      prefix = 'Enterprise ';
    }
    
    let suffix = '';
    if (role === 'founder') {
      suffix = 'Founder';
    } else if (role === 'developer') {
      suffix = 'Developer';
    } else if (role === 'pm') {
      suffix = 'Product Lead';
    } else if (role === 'designer') {
      suffix = 'Designer';
    } else {
      suffix = 'Builder';
    }
    
    let platformName = '';
    switch (platform) {
      case 'ios':
        platformName = 'iOS';
        break;
      case 'android':
        platformName = 'Android';
        break;
      case 'web':
        platformName = 'Web';
        break;
      case 'multiple':
        return `${prefix}Multi-Platform ${suffix}`;
    }
    
    return `${prefix}${platformName} ${suffix}`;
  }

  // Submit quiz
  async function submitQuiz() {
    const painPointsEl = document.getElementById('painPoints') as HTMLTextAreaElement;
    const painPoints = painPointsEl?.value?.trim() || '';
    
    // Show result screen immediately for better UX
    document.querySelectorAll('.quiz-step').forEach(step => {
      step.classList.add('hidden');
    });
    resultScreen.classList.remove('hidden');
    
    // Generate and show type
    const type = generateType(answers);
    resultType.textContent = type;
    
    // Create confetti
    createConfetti();
    
    // Submit to API in background
    try {
      const formData = new FormData();
      formData.append('waitlistId', waitlistIdInput.value);
      formData.append('role', answers.role || '');
      formData.append('platform', answers.platform || '');
      formData.append('teamSize', answers.teamSize || '');
      formData.append('disappointmentLevel', answers.disappointmentLevel || '');
      formData.append('painPoints', painPoints);
      
      await fetch('/api/quiz', {
        method: 'POST',
        body: formData,
      });
    } catch (err) {
      console.error('Quiz submission error:', err);
      // Don't show error to user - the optimistic UI already showed success
    }
  }

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitQuiz();
  });
</script>
