---
/**
 * Hero section for Illoominate landing page
 * Linear/Vercel inspired dark aesthetic with subtle gradient and staggered animations
 *
 * Accessibility: CTA contrast verified 2026-01-24
 * - bg-indigo-600 (#4f46e5) on white text: 7.2:1 ratio (WCAG AAA)
 * - Exceeds 4.5:1 minimum required for WCAG AA
 */
import { Code } from 'astro:components';

const sdkCode = `import Illoominate

// Initialize in 3 lines
let feedback = Illoominate(
  appKey: "pk_live_abc123",
  user: User(id: "user_42")
)

// Present native feedback UI
feedback.present()`;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background: Subtle gradient with noise texture -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0a0a0a] via-[#0f0f1a] to-[#0a0a0a]"></div>
  
  <!-- Mesh gradient accents -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/3 right-1/4 w-80 h-80 bg-violet-600/15 rounded-full blur-[100px]"></div>
  </div>
  
  <!-- Noise texture overlay -->
  <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Messaging -->
      <div class="text-center lg:text-left">
        <!-- Badge: Founding Member Offer -->
        <div class="hero-badge mb-8 inline-flex items-center gap-3 px-4 py-2 rounded-full bg-gradient-to-r from-indigo-500/10 to-purple-500/10 border border-indigo-500/20">
          <span class="text-lg">🎁</span>
          <span class="text-sm">
            <span class="text-indigo-400 font-semibold">40% lifetime discount</span>
            <span class="text-zinc-400"> for first 500</span>
          </span>
        </div>

        <!-- Headline -->
        <h1 class="hero-headline text-5xl md:text-7xl font-bold tracking-tight mb-6 bg-gradient-to-b from-white via-white to-zinc-500 bg-clip-text text-transparent">
          Ship fixes before<br />
          <span class="text-indigo-400">users complain</span>
        </h1>

        <!-- Tagline -->
        <p class="hero-tagline text-xl md:text-2xl text-zinc-400 max-w-2xl lg:mx-0 mx-auto mb-10 leading-relaxed">
          Native feedback SDKs that feel like part of your app.
          <span class="text-zinc-300">Built for indie developers</span> with pricing that scales with you, not against you.
        </p>

        <!-- CTA -->
        <a
          href="#waitlist"
          class="hero-cta inline-flex items-center gap-2 px-8 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition-all duration-200 hover:translate-y-[-2px] hover:shadow-[0_0_40px_rgba(99,102,241,0.4)]"
        >
          Claim Early Access
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>

        <!-- Subtle hint -->
        <p class="hero-hint mt-6 text-sm text-zinc-600">
          No credit card required. Founding member pricing for waitlist.
        </p>
      </div>

      <!-- Right: Product Preview (code snippet) -->
      <div class="hero-preview hidden lg:block relative rounded-2xl overflow-hidden border border-white/10 bg-[#0d0d12] shadow-2xl">
        <!-- Window chrome -->
        <div class="flex items-center gap-2 px-4 py-3 bg-[#0a0a0a] border-b border-white/5">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
          </div>
          <span class="text-xs text-zinc-500 ml-2">AppDelegate.swift</span>
        </div>

        <!-- Code -->
        <div class="p-4 text-sm">
          <Code code={sdkCode} lang="swift" theme="github-dark" />
        </div>

        <!-- Integration hint -->
        <div class="absolute bottom-4 right-4 text-xs text-zinc-600">
          <span class="text-emerald-400">8 lines</span> to integrate
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-50">
    <svg class="w-6 h-6 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<style>
  /* Staggered fade-in animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-badge {
    animation: fadeInUp 0.6s ease-out;
  }

  .hero-headline {
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }

  .hero-tagline {
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  .hero-cta {
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }

  .hero-hint {
    animation: fadeInUp 0.6s ease-out 0.4s both;
  }

  .hero-preview {
    animation: fadeInUp 0.6s ease-out 0.5s both;
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .hero-badge,
    .hero-headline,
    .hero-tagline,
    .hero-cta,
    .hero-hint,
    .hero-preview {
      animation: none;
      opacity: 1;
    }
  }
</style>
