---
/**
 * Technical comparison chart - Native SDK vs Webview
 * Proves native performance advantages with specific metrics
 */

const metrics = [
  {
    name: 'Main Thread Impact',
    native: '< 2ms',
    webview: '50-200ms',
    tooltip: 'Time blocked on main thread during SDK operations'
  },
  {
    name: 'Memory Overhead',
    native: '~8MB',
    webview: '~45MB',
    tooltip: 'Additional memory used by feedback SDK'
  },
  {
    name: 'UI Responsiveness',
    native: '60 FPS',
    webview: '30-45 FPS',
    tooltip: 'Frame rate during feedback form interactions'
  },
  {
    name: 'Offline Support',
    native: 'Full queue & sync',
    webview: 'Limited/None',
    tooltip: 'Ability to submit feedback without network'
  },
  {
    name: 'Startup Time',
    native: '< 50ms',
    webview: '500ms-2s',
    tooltip: 'Time to load feedback UI'
  },
];
---

<section class="py-24 bg-[#0a0a0a]">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-white text-center mb-4">
      Native performance, proven
    </h2>
    <p class="text-zinc-400 text-center mb-12 max-w-2xl mx-auto">
      See why native SDKs deliver a better user experience than webview-based alternatives.
    </p>

    <div class="rounded-2xl border border-white/10 overflow-hidden">
      <!-- Header -->
      <div class="grid grid-cols-3 bg-[#111] border-b border-white/10">
        <div class="p-4 text-sm font-medium text-zinc-400">Metric</div>
        <div class="p-4 text-sm font-medium text-center">
          <span class="text-indigo-400">Illoominate</span>
          <span class="text-xs text-zinc-500 block">Native SDK</span>
        </div>
        <div class="p-4 text-sm font-medium text-center text-zinc-500">
          Webview-based
          <span class="text-xs text-zinc-600 block">Competitors</span>
        </div>
      </div>

      <!-- Rows -->
      {metrics.map((metric, i) => (
        <div class={`grid grid-cols-3 ${i !== metrics.length - 1 ? 'border-b border-white/5' : ''}`}>
          <div class="p-4 text-sm text-white flex items-center gap-2">
            {metric.name}
            <span class="text-zinc-600 cursor-help" title={metric.tooltip}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </span>
          </div>
          <div class="p-4 text-sm text-center">
            <span class="text-emerald-400 font-medium">{metric.native}</span>
          </div>
          <div class="p-4 text-sm text-center text-zinc-500">
            {metric.webview}
          </div>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-zinc-600 mt-4">
      *Based on iOS 17 device benchmarks. Webview metrics from industry averages.
    </p>
  </div>
</section>
